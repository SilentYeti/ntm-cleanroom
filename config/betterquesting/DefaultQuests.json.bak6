   },
   "properties:10": {
    "betterquesting:10": {
     "visibility:8": "NORMAL",
     "icon:10": {
      "id:8": "hbm:machine_ore_slopper",
      "Count:3": 1,
      "Damage:2": 0,
      "OreDict:8": ""
     },
     "snd_complete:8": "random.levelup",
     "completion_particle:8": "default",
     "isSilent:1": 0,
     "snd_update:8": "random.levelup",
     "isMain:1": 0,
     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "Bedrock Ore Extracting",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "\u00a7eBedrock Ore Deposits\u00a7r are an infinite source of resourses which can be obtained by using a \u00a73Large Mining Drill\u00a7r and a \u00a73Bedrock Ore Processor\u00a7r. Operating the drill will consume\u00a7e 200kHE/s\u00a7r.\n\nBefore excavation can happen, the \u00a7eDepth Rock\u00a7r covering the bedrock ore deposit needs to be removed. An easy way of doing that is blowing up the rock with \u00a76Mining Charges\u00a7r.\n\nThe large mining drill is used to excavate \u00a76Raw Bedrock Ores\u00a7r from their deposits. The drill requires a \u00a76Drillbit\u00a7r to work\u00a7r, which can be upgraded to increase the speed at which it operates at. \u00a7eFortune\u00a7r on a drillbit affects the quality of mined bedrock ore, each level of fortune adds \u00a7e10%\u00a7r of the value to the item.\n\nThe bedrock ore processor takes \u00a76\u00a7rraw bedrock ore obtained from the drill and breaks it down into smaller pieces, each with different products that can be obtained from them. \n\u00a7a\u00a7bOre Slop\u00a7r, which is created when the machine is operating, can be processed into many useful products, especially when it is sent through an \u00a73Electrolysis Machine\u00a7r.\n\nThe \u00a76Bedrock Ore Density Scanner\u00a7r shows information on the composition of Bedrock Ore deposits.\n\nBedrock ore processing can be both an energy and resourse expensive operation so it is recommended that it is explored after having good infrastructure.\n\n\u00a72Consider adding a Power Saving Upgrade to the drill as it only reduces power without affecting the mining speed. Additionally, installing an Effectiveness Upgrade on the ore slopper will make it give out more resourses.\u00a7r\n\nMake sure to go to the bedrock ore processing chapter and follow the quests there for instructions. It is also recommended that the wiki is checked out.\n\n[url]https://nucleartech.wiki/wiki/Bedrock_Ore[/url]",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
    }
   },
