     "snd_complete:8": "random.levelup",
     "completion_particle:8": "default",
     "isSilent:1": 0,
     "snd_update:8": "random.levelup",
     "isMain:1": 0,
     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "Magnetohydrodynamic Turbines\u00a7r",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "\u00a73Magnetohydrodynamic Turbines\u00a7r are advanced components of the fusion reactor that make electricity out of the plasma energy directly without needing additional turbines. While more expensive and requiring \u00a7bPerfluoromethyl\u00a7r cooling, they have a \u00a7e+35%\u00a7r convertion bonus from \u00a7eTU\u00a7r to \u00a7eHE\u00a7r. In addition, the MDH turbine requires a minimum input of\n\u00a7e5MTU/t\u00a7r of plasma energy to operate normally, otherwise efficiency will be halved.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
