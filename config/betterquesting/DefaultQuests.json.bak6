     "snd_complete:8": "random.levelup",
     "completion_particle:8": "default",
     "isSilent:1": 0,
     "snd_update:8": "random.levelup",
     "isMain:1": 0,
     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "Ammo Press and Guns",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "With casting available through the \u00a73Crucible\u00a7r, many gun parts can now be created such as \u00a76Barrels\u00a7r and \u00a76Grips\u00a7r. An \u00a73Ammo Press\u00a7r is used to create the various ammunitions guns use.\n\nA \u00a73Weapon Modification Table\u00a7r can be used to install weapon mods, such as \u00a76Silencers\u00a7r and \u00a76Scopes\u00a7r.\n\nThe \u00a76Bullet Casing Bag\u00a7r will retrieve some of the casings when guns are fired.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
    }
