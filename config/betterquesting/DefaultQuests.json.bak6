     "globalShare:1": 0,
     "desc:8": "The \u00a73Battery Socket\u00a7r is used to hold \u00a76Batteries\u00a7r or \u00a76Capacitors\u00a7r.\n\nBatteries have more energy storage, but a slower discharge time, meaning that only a small amount of stored power can be outputted to the grid.\n\nCapacitors on the other hand, have less energy storage, but a faster discharge time.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
