     "isMain:1": 0,
     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "Gas Centrifuge",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "The \u00a73Gas Centrifuge\u00a7r is used to centrifuge \u00a7bUranium/Plutonium Hexafluoride\u00a7r to obtain enriched fuel for bombs and reactor fuel.\n\nTwo gas centrifuges in a row will yield \u00a76Uranium-238\u00a7r and \u00a76Uranium Fuel\u00a7r used in reactors. The uranium hexafluoride processing line does not consume the \u00a76Sulfur\u00a7r and \u00a76Fluorite\u00a7r, so loops are recommended.\n\nThe \u00a76Gas Centrifuge Overclocking Upgrade\u00a7r is needed to obtain \u00a76Uranium-235\u00a7r. Four gas centrifuges will have to be placed in a row and the upgrade on the last of them to obtain uranium-235 nuggets.\n\n[F1] For more information.\n",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
    }
   },
