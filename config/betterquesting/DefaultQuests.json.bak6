     "snd_complete:8": "random.levelup",
     "completion_particle:8": "default",
     "isSilent:1": 0,
     "snd_update:8": "random.levelup",
     "isMain:1": 0,
     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "Desh",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "\u00a76Desh\u00a7r is an alloy made up of 9 rare earth metals to make its blend form, which is solidified and refined using \u00a7bMercury\u00a7r and \u00a7bLight oil\u00a7r in the \u00a73Chemical Plant\u00a7r. Desh is an almost unbreakable material and as such its tools have infinite durability. \n\n\u00a7a\u00a72Desh can also be made using DeshReady\u2122 in a Rotary Furnace, or later on, in an Ore Acidizer.\u00a7r\n\nMercury at this stage of the game can be obtained from centrifuging \u00a7eRedstone Ore\u00a7r or putting \u00a7eCinnabar\u00a7r in a \u00a73Combination Oven\u00a7r. Large cinnabar veins can be found as depth ore.\n\nLater on, mercury can be obtained from processing \u00a7bOre Slop\u00a7r or \u00a7bVitriol\u00a7r in an \u00a73Electrolyzer\u00a7r.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
