   "properties:10": {
    "betterquesting:10": {
     "visibility:8": "NORMAL",
     "icon:10": {
      "id:8": "hbm:machine_fel",
      "Count:3": 1,
      "Damage:2": 0,
      "OreDict:8": ""
     },
     "snd_complete:8": "random.levelup",
     "completion_particle:8": "default",
     "isSilent:1": 0,
     "snd_update:8": "random.levelup",
     "isMain:1": 0,
     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "FEL and SILEX",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "The \u00a73FEL\u00a7r or Free Electron Laser is a large multiblock utilized with the SILEX to produce various laser wavelengths needed for all SILEX recipes.\n\nA single FEL can power up to 5 SILEX'es. In order to stop the laser any concrete block can be in the its path.\n\nThe lower the wavelength of the crystal, the faster recipes will be completed.\n\nThe \u00a76\u00a73SILEX\u00a7r is a machine that separates isotopes and elements from compounds or other materials via the SILEX (Separation of Isotopes by Laser Exitation) process. It allows for easier enrichment of \u00a76Uranium\u00a7r, \u00a76Plutonium\u00a7r, and \u00a76Australium\u00a7r.\n\nThe SILEX can also process \u00a76Lapis Lazuli\u00a7r into \u00a76Sulfur\u00a7r, \u00a76Aluminium\u00a7r, and most importantly \u00a76Cobalt\u00a7r. It can use \u00a7bHydrogen Peroxide\u00a7r to liquify any material to be processed, the material may even be in a powder state. The processed items come out into the right side collection of slots.\n\nThe SILEX must be placed at least 2 blocks away from activated FEL laser, or else its going to melt.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
    }
   },
