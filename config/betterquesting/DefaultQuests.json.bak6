     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "NTM: Introduction",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "This is the begining of the tech tree of \u00a7dHBM's Nuclear Tech Mod\u00a7r. Before proceeding it is recommended that you stock up on materials such as \u00a76Iron\u00a7r, \u00a76Coal\u00a7r, \u00a76Copper\u00a7r and \u00a76Redstone\u00a7r.\n\n\u00a7a\u00a72Some advanced machinery can be obtained by salvaging them from structures scattered across the world, such as Centrifuges from abandoned nuclear powerplants found in deserts, or by rare mob drops such as a Geiger Counter.\u00a7r\n\nThe NTM Wiki link can be found here:\n\n[url]https://nucleartech.wiki/wiki/Main_Page[/url]",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
