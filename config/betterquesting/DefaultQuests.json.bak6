     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "The \u00a76Network Tool\u00a7r, when right-clicking on any network device will bring up the tool's interface showing all devices connected to the network as well as network details. As any wrench, shift clicking on a cable will remove it.",
