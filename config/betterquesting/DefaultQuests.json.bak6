     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "Large Factory Multiblocks",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "OR",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "The \u00a73Chemical Factory\u00a7r is a large version of the \u00a73Chemical Plant\u00a7r, capable of performing 4 recipes in parallel. It has double the speed of the chemical plant but consumes twice as much power. Additionally, it consumes \u00a7bWater\u00a7r as a coolant, and produces \u00a7bLow-Pressure Steam\u00a7r, so a closed water cycle is recommended.\n\nThe \u00a73Assembly Factory\u00a7r is a large version of the \u00a73Assembly Machine\u00a7r, capable of performing 4 recipes in parallel. It functions the same as the chemical factory.",
     "completion_animation:8": "default",
