     "isMain:1": 0,
     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "Additional Modpack Information",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "\u00a75Schizophrenia\u00a7r comes packed with many QoL mods as well as some mods that aren't very apparent at first.\n\n1) \u00a7dFallingTree\u00a7r fells whole trees in one go when you chop the base log.\n\n2) \u00a7dWeather2\u00a7r adds proper storms and blizzards with real gameplay impact, on top of the usual weather.\n\n3) \u00a7dDimensional Doors\u00a7r adds an entire extra dimension (Limbo) accessible through unstable rifts - handle with care.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
    }
