     "snd_complete:8": "random.levelup",
     "completion_particle:8": "default",
     "isSilent:1": 0,
     "snd_update:8": "random.levelup",
     "isMain:1": 0,
     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "ZIRNOX",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "The \u00a73ZIRNOX\u00a7r is the first and cheapest nuclear reactor that one can make. Unlike the \u00a73PWR\u00a7r and \u00a73RBMK\u00a7r, it is a fully assembled reactor which requires \u00a7bWater\u00a7r and \u00a7bCarbon Dioxide\u00a7r to operate.\n\nDue to the low amount of steam the ZIRNOX makes, one can use the singleblock \u00a73Steam Turbines\u00a7r, at the cost of \u00a7e85%\u00a7r efficiency, and a single \u00a73Steam Condenser\u00a7r on lower power fuels. Thus, 24 \u00a76Natural Uranium Fuel Rods\u00a7r using 14kmB of carbon dioxide will yield a power output of around \u00a7e160kHE/s\u00a7r.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
    }
   },
