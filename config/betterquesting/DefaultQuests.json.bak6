     "questLogic:8": "AND",
     "name:8": "Cadmium",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "\u00a76Cadmium\u00a7r is a material needed to make \u00a76Cadmium Stee\u00a7rl, which is a substitute of \u00a76Technetium Steel\u00a7r.\n\nCadmium can be obtained by smelting cadmium powder, which can be obtained acidizing 10 \u00a76Mustard Willow leaves\u00a7r with 250mB of \u00a7bHigh-Perfomance Solvent\u00a7r in the \u00a73Ore Acidizer\u00a7r.\n\nThe mustard willow is a plant that can be found near \u00a7eBedrock Oil Deposits\u00a7r. When it's fully matured, the main item can be obtained, that being the mustard willow leaf.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
