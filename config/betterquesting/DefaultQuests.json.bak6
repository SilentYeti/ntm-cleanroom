     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "The \u00a73Pyrolysis Oven\u00a7r is a mid-to-late game oil processing machine that allows easier production pf \u00a76Crystalline Fullerite\u00a7r, which is needed in bulk for late-game machines onwards. \n\nIt can process an item with an optional fluid to produce another item and/or fluid. Functionally, it works similar to the \u00a73Combination Oven\u00a7r, mostly in bedrock ore processing.\nIts main use however is in production of \u00a76Fullerene\u00a7r, as it can turn \u00a76Tar\u00a7r into \u00a76Fine Soot\u00a7r, eliminating the RNG of a \u00a73Smokestack\u00a7r.\n\nOperating the pyrolysis oven will consume \u00a7e200kHE/s\u00a7r.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
