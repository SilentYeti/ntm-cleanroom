    }
   },
   "properties:10": {
    "betterquesting:10": {
     "visibility:8": "NORMAL",
     "icon:10": {
      "id:8": "minecraft:portal",
      "Count:3": 1,
      "Damage:2": 0,
      "OreDict:8": ""
     },
     "snd_complete:8": "random.levelup",
     "completion_particle:8": "default",
     "isSilent:1": 0,
     "snd_update:8": "random.levelup",
     "isMain:1": 0,
     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "The Nether",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "\u00a7eThe Nether\u00a7r is entirely optional for \u00a7dNTM\u00a7r progression, but is home to many resourses, such as:\n\n\u00a76Quartz\u00a7r\u00a7r which can be used for \u00a76Silicon\u00a7r.\n\n\u00a76Infernal Coal\u00a7r which can be shredded for \u00a76Coal Powder\u00a7r. A mask or suit that can protect against Carbon Dioxide is needed to mine the deposits.\n\n\u00a76Sulfur\u00a7r needed for various chemical processes.\n\n\u00a76Red Phosphorus\u00a7r for incendiary weaponry.\n\n\u00a76Glowstone\u00a7r for early \u00a7bChlorine Gas\u00a7r in a \u00a73Combination Oven\u00a7r.\n\n\u00a76Cobalt\u00a7r can also be rarely found near the Nether Roof.\n\nThe Nether has a backround radiation of \u00a7e0.1RAD/s\u00a7r.\u00a7r\n\n\u00a72Glowstone, Quartz and Phosphorus Bedrock Ore Deposits also exist.\u00a7r\n\n\u00a72Depth Neodymium Deposits also spawn exclusively in the Nether.\u00a7r\n",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
    }
   },
