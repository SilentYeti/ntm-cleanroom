     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "Mining Charge",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "OR",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "The \u00a73Mining Charge\u00a7r is an explosive made with the express purpose of mining, as such it's commonly used to mine depth ores, since it dosen't destroy drops, before getting a pickaxe that can do the same. Mining Charges are a great way of obtaining \u00a76Zirconium\u00a7r from depth ores for nuclear fuel rods.\n\nIt has an explosion radius of about 3 blocks and explodes instantly upon being powered by redstone, while exploding it does no damage to entities.\n\nThere are two other variants of this, being the \u00a73Timed Mining Charge\u00a7r and the \u00a7b\u00a73Semtex Mining Charge\u00a7r, they are both timed explosives with the semtex one being stronger than the regular one and having \u00a7eFortune 3\u00a7r, meanwhile the timed mining charge does not seem to have enhanced capabilities, other than being timed and thus more convinient to use.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
    }
   },
