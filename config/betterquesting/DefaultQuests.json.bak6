     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "AE2 Changes",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "In this modpack, \u00a7dApplied Energistics 2\u00a7r has been changed to fit in more with \u00a7dNTM\u00a7r. Many components now require NTM materials (steel plates, quartz glass, circuits) instead of their vanilla AE2 ingredients - check JEI for the updated recipes.\n\n\u00a72This chapter's descriptions are adapted from the FTB Wiki.\u00a7r\n\n[url]https://ftbwiki.org/Applied_Energistics_2[/url]",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
