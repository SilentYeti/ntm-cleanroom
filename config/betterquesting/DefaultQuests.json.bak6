     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "BTX",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "\u00a7bBTX\u00a7r is a high-grade powerful fuel which generates a lot of power when burnt. An important use of BTX is in the creation of \u00a76Crystalline Fullerite\u00a7r and \u00a76Hard Plastic Bars\u00a7r. BTX can be obtained from a \u00a73Hydrotreater\u00a7r, but it is more efficient to use \u00a7bReformate\u00a7r from a \u00a73Vacuum Refinery\u00a7r.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
