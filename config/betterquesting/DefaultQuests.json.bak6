     "snd_complete:8": "random.levelup",
     "completion_particle:8": "default",
     "isSilent:1": 0,
     "snd_update:8": "random.levelup",
     "isMain:1": 0,
     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "ROR Arc Furnace Automation",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "\u00a72This quest serves as a guide on how to precisely input items in an arc furnace as not to waste electrode durability.\u00a7r\n\nAssuming no upgrades are inserted in the \u00a73Arc Furnace\u00a7r, there are exactly 20 slots available for items. To start, route all input items into a \u00a73Conveyor Boxer\u00a7r which will send items into a \u00a73Conveyor Unboxer\u00a7r. Adding speed ejection and stack ejection upgrades to the unboxer is highly recommended as so the items are inputed fast enough.\n\n[img height=1000]betterquesting:textures/BQ_ARC1.png[/img]\n\nPlace a \u00a73Redstone-Over-Radio Item Counter\u00a7r on one side of the boxer, set the item filter and give it an ID.\n\n[img height=1000]betterquesting:textures/BQ_ARC2.png[/img]\n\nThen place a Redstone-Over-Radio Logic Receiver, give it the correct ID, and set it to emit redstone when item count is 20.\n\n[img height=1000]betterquesting:textures/BQ_ARC3.png[/img]\n\nMake sure that the boxer has its mode set to redstone.\n\n[img height=1000]betterquesting:textures/BQ_ARC4.png[/img]",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
    }
   },
