     "name:8": "ROR Redstone Fluid Overflow",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "OR",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "\u00a76\u00a73Redstone-Over Radio\u00a7r in combination with a \u00a73Redstone Fluid Valve\u00a7r can be used to detect when a tank is starting to fill up, and release the insides. This is useful for having buffers without having all the fluids being wasted.\n\n\u00a72Here is an exmaple of a tank that will only output fluid once its full:\u00a7r\n\nFirstly, place a \u00a76ROR Transmitter\u00a7r on one port of the tank, provide an ID and enable Polling.\n\n[img height=1000]betterquesting:textures/QB_Fluid1.png[/img]\n\nAfter that, place a \u00a76ROR Logic Receiver\u00a7r next to the fluid valve and input the desired settings. Make sure that your signal is >= of your desired buffer. One redstone level equals to 16k mb.\n\n[img height=1000]betterquesting:textures/QB_Fluid2.png[/img]\n\nA \u00a73Fluid Control Pump\u00a7r can also be used to limit throughput of fluids and to also add priorities.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
    }
   },
