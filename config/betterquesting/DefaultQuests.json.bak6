   "properties:10": {
    "betterquesting:10": {
     "visibility:8": "NORMAL",
     "icon:10": {
      "id:8": "hbm:nuke_man",
      "Count:3": 1,
      "Damage:2": 0,
      "OreDict:8": ""
     },
     "snd_complete:8": "random.levelup",
     "completion_particle:8": "default",
     "isSilent:1": 0,
     "snd_update:8": "random.levelup",
     "isMain:1": 0,
     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "Nuclear Bombs",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "OR",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "With access to \u00a76Tantalum\u00a7r for \u00a76Control Units\u00a7r and fissile matterials, it is possible to assemble a nuclear bomb. To detonate the bomb one can use a detonator or a redstone signal.\n\nA nuclear explosion will transform ores into more valuable ones, such as \u00a76Coal\u00a7r to \u00a76Diamonds\u00a7r or \u00a76Uranium\u00a7r to \u00a76Schrabidium\u00a7r. Be prepared with radiation resistant armor before venturing into the crater.\n\nMake sure to stand behind some strong cover if you wish to see the explosion from close by.\n\n\u00a72This quest serves as a list of components needed for various bombs. Some of these components can be mounted onto rockets that will carry the payload over large distances.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
    }
   },
   "rewards:9": {},
