     },
     "snd_complete:8": "random.levelup",
     "completion_particle:8": "default",
     "isSilent:1": 0,
     "snd_update:8": "random.levelup",
     "isMain:1": 0,
     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "Gerald the Construction Android",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "\u00a76Gerald the Construction Android\u00a7r is the most powerful weapon in the mod. Using this has the side effect of setting the world on fire but also getting tektite, which contains \u00a76Osmiridium\u00a7r.\n\nGerald is the hardest recipe of the mod requiring hundreds of thousands of items, mainly circuit related.\n\nVast quantities of \u00a76Bismuth\u00a7r, \u00a76Tantalum\u00a7r and \u00a76Silicon\u00a7r are needed, so dont hold back on bedrock ore processing and parallelisation of many processes. If you havent already used \u00a7dAE2\u00a7r, it is highly recommended at this stage of the game.\n\nLaunching Gerald will result in a global firestorm that will decimate all life, including all trees and grass. Make sure to keep a backup of your world before launching him. Gerald can also be launched in the \u00a7eNether\u00a7r or \u00a7eEnd\u00a7r.\n\n\u00a72A Plasma Forge with a plasma input energy of 25MTU/t is required.\u00a7r \u00a72DHC or Stellar Flux plasma is needed.\u00a7r\n\n\u00a72Blueprints can be found in structures, purchased from Bobmazon or made in a Precision Assembler.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
    }
