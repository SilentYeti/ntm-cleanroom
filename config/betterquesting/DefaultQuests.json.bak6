    2
   ]
  },
  "131:10": {
   "tasks:9": {
    "0:10": {
     "index:3": 0,
     "taskID:8": "bq_standard:checkbox"
    }
   },
   "properties:10": {
    "betterquesting:10": {
     "visibility:8": "NORMAL",
     "icon:10": {
      "id:8": "hbm:bedrock_ore_new",
      "Count:3": 64,
      "Damage:2": 145,
      "OreDict:8": ""
     },
     "snd_complete:8": "random.levelup",
     "completion_particle:8": "default",
     "isSilent:1": 0,
     "snd_update:8": "random.levelup",
     "isMain:1": 0,
     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "Solvent Washed Bedrock Ore",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "After the first centrifuging stage, ores can be washed with various fluids to increase primary products or add byproducts, these include:\n\n\u00a7s\u00a7bSulfuric Acid\u00a7r - adds the first tier of byproducts to your outputs\n\n\u00a7bSolvent\u00a7r - adds the second tier of byproducts\n\n\u00a7bHigh-Performance Solvent\u00a7r - adds the final tier of byproducts\n\n\u00a7bLiquid Hydrogen\u00a7r - increases the yield of the first primary product\n\n\u00a7bChlorine Gas\u00a7r - increases the yield of the second primary product\n\n\u00a72Note that processing with higher tier solvents will produce lower tier products as well, meaning processing with HPS will provide all available byproducts. Ores processed with lower tier solvents can be processed again with higher tiers to further increase yields, doubling outputs each time!",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
    }
   },
   "rewards:9": {},
   "questID:3": 158,
   "preRequisites:11": [
    29
   ]
  },
  "132:10": {
   "tasks:9": {
    "0:10": {
     "index:3": 0,
     "taskID:8": "bq_standard:checkbox"
    }
   },
   "properties:10": {
    "betterquesting:10": {
     "visibility:8": "NORMAL",
     "icon:10": {
      "id:8": "hbm:glyphid_base",
      "Count:3": 1,
      "Damage:2": 0,
      "OreDict:8": ""
     },
     "snd_complete:8": "random.levelup",
     "completion_particle:8": "default",
     "isSilent:1": 0,
     "snd_update:8": "random.levelup",
     "isMain:1": 0,
     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "Glyphids",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "\u00a7G\u00a76Glyphids\u00a7r are large insects that have many different types. They primarily spawn with naturally generated \u00a76\u00a7rhives\u00a7r structures. All of the types are armored and they take less damage than against normal mobs. Glyphids are normally attracted to pollution created by the player, and usually have to be dealt with by the player.\n\n\u00a76\u00a7r\u00a76Hives\u00a7r can spawn naturally in all non-ocean biomes and can also be created by glyphid scouts. They contain several glyphid egg blocks and some low-tier loot inside, lying on top of eggs. glyphid egg blocks spawn glyphids and drop glyphid eggs upon destruction.\n\n\u00a72It is recommended that all hives are destroyed as soon as possible as to prevent their spread later on.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
    }
   },
