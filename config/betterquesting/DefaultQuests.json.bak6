     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "Smokestack",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "OR",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "The \u00a73Smokestack\u00a7r is used to reduce pollution made from machines. \u00a73Exhaust Pipes\u00a7r, made in anvils, can be used to transport the fumes to the Smokestack. The \u00a73Industrial Smokestack\u00a7r is needed to produce \u00a76Fine Soot\u00a7r, required for making \u00a76Fullerite\u00a7r in the late game.\n\nAn \u00a73Ashpit\u00a7r can be installed beneath the Smokestack which will collect \u00a76Ash\u00a7r, that can be used as a cheap black dye alternative aswell as in the creation of \u00a76Industrial Fertilizer\u00a7r.\n\nThe wiki page for pollution can be found below.\n\n[url]https://nucleartech.wiki/wiki/Pollution[/url]",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
