     "simultaneous:1": 0,
     "taskLogic:8": "OR",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "\u00a7dStorage Drawer Keys\u00a7r can be used to modify Drawers in many ways.\n\nThe \u00a7dDrawer Key locks drawers\u00a7r, so no new item types can be inserted into the drawer when its empty.\n\nThe \u00a7dConcealment Key\u00a7r hides the item icon of drawers.\n\nThe \u00a7dQuantify Key\u00a7r shows the item quantities of drawers.\n\nThe \u00a7dPersonal Key\u00a7r protects drawers from other players (outside of claims). \n",
     "completion_animation:8": "default",
     "confetti_icon:10": {
