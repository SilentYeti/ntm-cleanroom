  "161:10": {
   "tasks:9": {
    "0:10": {
     "index:3": 0,
     "taskID:8": "bq_standard:checkbox"
    }
   },
   "properties:10": {
    "betterquesting:10": {
     "visibility:8": "NORMAL",
     "icon:10": {
      "id:8": "minecraft:end_portal",
      "Count:3": 1,
      "Damage:2": 0,
      "OreDict:8": ""
     },
     "snd_complete:8": "random.levelup",
     "completion_particle:8": "default",
     "isSilent:1": 0,
     "snd_update:8": "random.levelup",
     "isMain:1": 0,
     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "The End",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "\u00a7eThe End\u00a7r is entirely optional for \u00a7dNTM\u00a7r progression, but is home to \u00a76Trixite\u00a7r, a unique extraterrestrial mineral that when processed can yield \u00a76Plutonium\u00a7r, \u00a76Cobalt\u00a7r and \u00a76Niobium\u00a7r. The Niobium is of great interest as it is a great source for early \u00a73Catalytic Cracking Towers\u00a7r.\n\nDue to only the main end island existing, Trixite Ore is a limited resourse.\u00a7r Trixite Crystals can also be obtained from an \u00a76Asteroid Mining Ship\u00a7r, but it is not recommended.\n\n\u00a7dEt Futurum Requiem\u00a7r backports many modern end features, such as \u00a7eChorus Fruit\u00a7r and a respawnable \u00a7eEnder Dragon\u00a7r using \u00a76End Crystals\u00a7r.\n\nThe \u00a76Dragon Egg\u00a7r can also be used to create a Backpack which provides passive \u00a7eNight Vision\u00a7r, \u00a7eStrength 2\u00a7r and \u00a7eFire resistance\u00a7r, aswell as some \u00a7eRegeneration\u00a7r when on low health.\n\nEnderman farms can also be made using \u00a73Fans\u00a7r to push the endermen into the killing zone.\n\n",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
    }
   },
