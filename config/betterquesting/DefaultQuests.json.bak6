     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "\u00a76Certus Quartz\u00a7r is an important material in AE2. It is dropped when mining or processing certus quartz ore at the rate of one to four, the yield is affected by a tool's Fortune enchantment. Certus Quartz is often interchangeable with vanilla \u00a76Nether Quartz\u00a7r in the recipes for basic tools, such as the \u00a76Quartz Cutting Knife\u00a7r. Certus quartz ore can be acidized or centrifuged for an increased yield.\n\n\u00a72Certus quartz can later be made in a Chemical Plant using nether quartz.",
     "completion_animation:8": "default",
