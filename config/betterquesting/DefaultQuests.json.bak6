     "snd_complete:8": "random.levelup",
     "completion_particle:8": "default",
     "isSilent:1": 0,
     "snd_update:8": "random.levelup",
     "isMain:1": 0,
     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "Research and Breeding Reactor",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "The \u00a73Research Reactor\u00a7r is a non-power reactor intended for burning fuel efficiently and acting as a neutron source for \u00a73Breeding Reactor\u00a7ss\u00a7r. It has to be submerged in \u00a7bWater\u00a7r to cool since it does not have the active cooling of a typical power reactor. A \u00a76Ra226Be\u00a7r or \u00a76Pu238Be\u00a7r neutron source plate is needed to begin the reaction, and then can be removed. It explodes at exactly \u00a7e1,000\u00b0C\u00a7r, so caution is advised when using strong fuels and several breeders simultaneously.\n\nA \u00a73Reactor Remote Control\u00a7  Block\u00a7r\nand a \u00a76Reactor Remote Sensor\u00a7r can be used to activate and monitor the reactor from a distance.\n\nThe Breeding Reactor breeds isotopes of elements into heavier forms using the neutron flux of an adjacent Research Reactor. When the reactor is operating, rays of green-ish \"lightning\" emitted from the center rod of the model can be seen going to the outer rods from the glass observation window.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
    }
