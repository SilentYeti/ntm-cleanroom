       "Damage:2": 0,
       "Count:3": 1,
       "id:8": "appliedenergistics2:spatial_io_port",
       "OreDict:8": ""
      }
     },
     "partialMatch:1": 1,
     "consume:1": 0,
     "autoConsume:1": 0,
     "taskID:8": "bq_standard:retrieval",
     "ignoreNBT:1": 1
