     "snd_complete:8": "random.levelup",
     "completion_particle:8": "default",
     "isSilent:1": 0,
     "snd_update:8": "random.levelup",
     "isMain:1": 0,
     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "Boiler and Steam Condenser",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "The \u00a73Boiler\u00a7r, when receiving heat from below, heats up fluids. Two important uses of the boiler are for \u00a7bSteam\u00a7r and \u00a7bOil\u00a7r processing which will come later on. The Boiler can explode if its output is full.\n\nSteam, when used by machines, such as reactors sending steam through \u00a73Turbines\u00a7r or \u00a73Chemical Factories\u00a7r produce \u00a7bLow-Pressure Steam\u00a7r. The low-pressure steam can be recycled back to retrieve 100% of the water by using a \u00a73Steam Condenser\u00a7r. Closed water loops are recommended for reactors.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
    }
   },
