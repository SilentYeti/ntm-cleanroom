  "144:10": {
   "tasks:9": {
    "0:10": {
     "index:3": 0,
     "taskID:8": "bq_standard:checkbox"
    }
   },
   "properties:10": {
    "betterquesting:10": {
     "visibility:8": "NORMAL",
     "icon:10": {
      "id:8": "hbm:particle_empty",
      "Count:3": 1,
      "Damage:2": 0,
      "OreDict:8": ""
     },
     "snd_complete:8": "random.levelup",
     "completion_particle:8": "default",
     "isSilent:1": 0,
     "snd_update:8": "random.levelup",
     "isMain:1": 0,
     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "Additional Particle Accelerator information",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "\u00a73Particle Accelerators\u00a7r are either two types; linear (straight) or circular (synchronous) accelerators. Since circles do not exist in Minecraft, synchronous accelerators are square in design. They are both modular and can be built to any size, with the only restriction being resources, intended byproduct, and energy costs.\n\nMost of the components within particle accelerators require cooling via \u00a7bCold Perfluoromethyl\u00a7r. The hot perfluoromethyl can be redirected to a \u00a73Compressor\u00a7r for re-cooling, creating a feedback loop despite energy loss.\n\nParticles start slowly and accelerate. Particles only do 1 component per tick, which increases by 1 every 1,000 momentum\n\nUsing a \u00a76Screwdriver\u00a7r on a beamline toggles a window which flashes if a particle passes.\n\nThe particle accelerator requires couple \u00a7eMHEs\u00a7r to function properly. Fission reactors or fusion can be used to meet these power needs.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
    }
   },
