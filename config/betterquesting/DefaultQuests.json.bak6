     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "Hydraulic Fracking Tower",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "The \u00a73Hydraulic Fracking Tower\u00a7r is used to extract infinite oil from a \u00a7eBedrock Oil Deposit\u00a7r. To operate, the machine needs \u00a7bFracking Solution\u00a7r. During its operation, the surrounding environment will sustain considerable damage. \u00a76Oily Dirt\u00a7r and \u00a76Oily Sand\u00a7r can be used to create \u00a76Arsenic\u00a7r, a substitute of \u00a76Bismuth\u00a7r.\n\nOperating the hydraulic fracking tower will consume \u00a7e100kHE/s\u00a7r.\n",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
