     "snd_complete:8": "random.levelup",
     "completion_particle:8": "default",
     "isSilent:1": 0,
     "snd_update:8": "random.levelup",
     "isMain:1": 0,
     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "Blast Furnace",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "The \u00a73Blast Furnace\u00a7r is a solid fuel-powered furnace used to create different alloys out of two inputs. The main starter alloys are: \u00a76Minecraft Grade Copper\u00a7r and \u00a76Steel\u00a7r. Inserting \u00a7bHot Air Blast\u00a7r, made by putting \u00a7bCompressed Air\u00a7r in a \u00a73Boiler\u00a7r, grants all recipes a \u00a7e5x\u00a7r boost.\n\u00a7bFlue Gas\u00a7r produced from operating the machine can be burnt for energy or vented into the atmosphere.\n\nSteel tools come equiped with vein mining, making them an excellent early-game tool.\n\n\u00a72For more advanced tools later on, pressing the ALT key will bring up a menu from which one can select multiple abilities at once.\u00a7r",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
    }
