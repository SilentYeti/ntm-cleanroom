     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "Tantalum",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "\u00a76Tantalum\u00a7r is a material needed for the creation of some items, most importantly \u00a76Capacitor Boards\u00a7r. Tantalum Polycrystal production requires \u00a76Coltan\u00a7r which can be located by the use of a \u00a76Coltass\u00a7r. Tantalum can be obtained from using \u00a7bHigh-Performance Solvent\u00a7r on \u00a7eHeavy Metal Bedrock Ore\u00a7r.\n\n\u00a72Coltan Processing at its early stage can provide Niobium needed for Catalytic Cracking Towers.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
