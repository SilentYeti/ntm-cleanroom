     "snd_complete:8": "random.levelup",
     "completion_particle:8": "default",
     "isSilent:1": 0,
     "snd_update:8": "random.levelup",
     "isMain:1": 0,
     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "Electric Arc Furnace",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "The \u00a73Electric Arc Furnace\u00a7r is a large automated furnace multiblock machine that can fill the role of \u00a73Crucible\u00a7r and automated smelter, and is required for progression as it is the only machine that can produce \u00a76Silicon\u00a7r from various sources, such as \u00a76Sand\u00a7r, \u00a76Flint\u00a7r, \u00a76fiberglass\u00a7r, and \u00a76Asbestos\u00a7r.\n\nTo operate this machine, it will require both electrical power and crafted \u00a77\u00a76Electrodes\u00a7r. In terms of electricity, the machine has a maximum storage capacity of \u00a7e2.5MHE\u00a7r, and consumes \u00a7e20kHE/s\u00a7r in operation, making it reasonably power hungry. In terms of the electrodes required for operation, there are four types available, and the machine must have three installed before it can operate.\n\nThis machine can operate in two different modes: Solid mode, which is the easiest to setup and use, great for initial crafting, and Liquid mode, which produces castable molten ores much like the crucible, with a small bonus to output, increasing efficiency of extraction from various ores.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
