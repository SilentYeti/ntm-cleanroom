     "snd_complete:8": "random.levelup",
     "completion_particle:8": "default",
     "isSilent:1": 0,
     "snd_update:8": "random.levelup",
     "isMain:1": 0,
     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "Soyuz-FG",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "The \u00a73Soyuz-FG Rocket\u00a7r is an immensely powerful Soviet rocket that is the primary launch vehicle for all satellites. The rocket must be launched from a suitably large mount - in this case, the \u00a73Soyuz Launch Platform\u00a7r.\n\nIt requires 128,000mB of \u00a7bKerosene\u00a7r and \u00a7bLiquid Oxygen\u00a7r to be launched as well as \u00a7e750kHE\u00a7r of power. Pressing the launch button starts a 30 second countdown. After the countdown has completed, the Soyuz will launch.\n\nThe Soyuz can, alongside its primary ability to deliver any satellite to orbit, also be set to a cargo mode, in which it can deliver any provided cargo to a distant spot across the world. Obviously, this is an incredibly expensive way to transport goods, and currently doesn't provide much utility.\n\nThe Soyuz is also the only rocket able to launch \u00a76Gerald\u00a7r.\n\n\u00a72Blueprints can be found in structures, purchased through Bobmazon or made in a Precision Assembler.\n",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
    }
   },
