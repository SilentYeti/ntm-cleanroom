     "name:8": "Coker Unit",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "The \u00a73Coker Unit\u00a7r is a machine that turns oil products into \u00a76Petroleum Coke\u00a7r, which is the same to the other kinds of coke, aswell as additional fluids as byproducts. The coker unit will require an external heat source in order to function, similar to the \u00a73Crucible\u00a7r.\n\n\u00a72\u00a7r\u00a72Alongside the \u00a72\u00a7r\u00a72\u00a7r\u00a72Electric Arc Furnace, the coker unit is one of the most polluting machines of the mod. It spreads 20 soot per second, making it a dangerous machine to use next to a glyphid nest.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
