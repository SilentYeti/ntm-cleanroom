     "questLogic:8": "AND",
     "name:8": "Tanks and Barrels",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "OR",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "\u00a73Tanks\u00a7r and \u00a73Barrels\u00a7r are useful storage devices that can hold various fluids in various amounts. Each tank and barrel supports holding different types of corrosive, hot, or exotic fluids, and knowing which ones can hold your desired fluids can be vital to your fluid processing and storage facilities.\n\nTanks can hold up to 256,000mb of fluids, while a Steel Barrel can hold 16,000.\n\n\u00a74\u00a72Tanks cant hold highly Antimatter and Corrosive fluids and as such a Big-Ass Tank 9000 or a Magnetic Tank is needed respectively.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
