     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "Before \u00a7bCrude Oil\u00a7r can be processed, it must be heated up in a \u00a73Boiler\u00a7r.\n\nThe \u00a73Oil Refinery\u00a7r splits Hot Crude Oil(or later on \u00a7bCracked\u00a7r) into four different fluid products and one solid byproduct.\n\nAfter that, those fluids can be sent through a \u00a73Fractioning Tower\u00a7r to obtain different kinds of fuels, such as \u00a7bKerosene\u00a7r and \u00a7bDiesel\u00a7r. A \u00a73Fractioning Tower Seperator\u00a7r can be used to stack fractioning towers ontop of eachother.\n\nIt is recommended that the wiki is checked out.\n\n[url]https://nucleartech.wiki/wiki/Guide:_Petroleum_Processing[/url]\n",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
