     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "\u00a76Fluix Crystals\u00a7r are another crystal type which is used in crafting recipes throughout the mod. The crystal comes in two forms, the regular fluix crystal and the \u00a76Pure Fluix Crystal\u00a7r.\n\nTo create a fluix crystal, 1\u00a76 Charged Certus Quartz\u00a7r, 1 \u00a76Nether Quartz\u00a7r, and 1 \u00a76Redstone Dust\u00a7r must be dropped into a pool of \u00a7bWater\u00a7r. They will be consumed and output 2 fluix crystals.\n\n\u00a72Fluix crystals can later be made in a Chemical Plant using charged certus quartz and redstone.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
