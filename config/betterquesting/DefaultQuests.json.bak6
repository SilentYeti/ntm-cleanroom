     "snd_update:8": "random.levelup",
     "isMain:1": 0,
     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "Additional Fusion Attachments",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "OR",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "The \u00a73Fusion Reactor Coupler\u00a7r turns outgoing plasma energy from a torus into usable \u00a7eKyE\u00a7r which can then be used to power another torus. Some fuel combinations require this, as the minimum \u00a7eKyE\u00a7r energy needed to ignite the plasma exceeds what four \u00a73Klystrons\u00a7r could deliver.\n\nThe \u00a73Fusion Reactor Breeding Chamber\u00a7r uses neutron flux from a torus to in order to process materials. It can perform any recipe from an \u00a73RBMK irradiation channel\u00a7r, with some additional recipes aswell. The neutron flux is not affected by port sharing rules, and the output level is the same on any side.\n\nThe \u00a73Fusion Reactor Collection Chamber\u00a7r increases the byproduct production rate by \u00a7e50%\u00a7r.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
