     "snd_complete:8": "random.levelup",
     "completion_particle:8": "default",
     "isSilent:1": 0,
     "snd_update:8": "random.levelup",
     "isMain:1": 0,
     "lockedProgress:1": 0,
     "repeat_relative:1": 1,
     "questLogic:8": "AND",
     "name:8": "Modpack Introduction",
     "repeatTime:3": -1,
     "particle_count:3": -1,
     "countAsQuest:1": 1,
     "simultaneous:1": 0,
     "taskLogic:8": "AND",
     "autoClaim:1": 0,
     "globalShare:1": 0,
     "desc:8": "Welcome to \u00a75Schizophrenia\u00a7r!\n\nPlease read the following information before starting out.\n\n1) Manually updating \u00a73\u00a7dNTM\u00a7r will cause new/changed recipes to not load. To update either wait for a new pack release, or better yet, head over to the config folder to the file named \"hbmRecipes\" and follow the same underscore convention used there.\n\n2) Remember to claim and chunkload your base and reactors using \u00a73\u00a7dChickenChunks\u00a7r.\n\n3) If shaders are glitching out try to use fancy textures.\n\n4) If you are encountering any rendering problems, try to scroll around in \u00a7dHEI\u00a7r (Had Enough Items).\n\nThis quest book was adapted from the \"Nuclear Tech- Integrated\" (1.7.10) modpack's quest book for use in Schizophrenia.\n\n\u00a7a\u00a72Special thanks to everyone who worked on the original quest book, as well as the official NTM Wiki for providing information used in the quests.",
     "completion_animation:8": "default",
     "confetti_icon:10": {
      "id:8": "minecraft:stick",
      "Count:3": 0,
      "Damage:2": 0,
      "OreDict:8": ""
     }
    }
   },
